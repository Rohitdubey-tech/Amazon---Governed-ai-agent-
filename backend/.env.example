APP_ENV=development
APP_NAME=AgentShield AI
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Security & JWT
JWT_SECRET_KEY=demo_super_secret_jwt_key_change_in_production_12345
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=agentshield_ai

# External AI Provider (Gemini)
GEMINI_API_KEY=
MOCK_GEMINI=true

# Storage
STORAGE_MODE=local
LOCAL_STORAGE_PATH=./storage

