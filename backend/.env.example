# ==============================================================================
# AgentShield AI - Environment Configuration
# ==============================================================================

# 1. External AI Provider (Google Gemini API)
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# 2. Database Connection (MongoDB)
# Local: mongodb://localhost:27017/agentshield_ai
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/agentshield_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=agentshield_ai

# 3. Security & Cryptographic Tokens (256-bit Hex Key)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=ae8b22bc86cbbefa48c589144b462a6cc5a0e2375aa7283a25ae5e9c9c37617e
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 4. Frontend & CORS URL
# Local: http://localhost:5173
# Production: https://your-agentshield-frontend.vercel.app
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# 5. Core Application Settings
APP_ENV=development
APP_NAME=AgentShield AI
PORT=8000
HOST=0.0.0.0
MOCK_GEMINI=false
STORAGE_MODE=local
LOCAL_STORAGE_PATH=./storage
