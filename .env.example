# Application & Environment
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_secure_random_string_32_chars_min
JWT_SECRET_KEY=change_this_to_another_secure_random_jwt_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Leave blank to run in resilient local in-memory fallback)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=agentshield_ai

# LLM Integration (Optional for live Gemini API calls; defaults to deterministic mock mode)
GEMINI_API_KEY=

# Frontend & CORS Allowlist
FRONTEND_ORIGIN=http://localhost:5173

# Document Storage Mode
STORAGE_MODE=local
LOCAL_STORAGE_PATH=./storage

